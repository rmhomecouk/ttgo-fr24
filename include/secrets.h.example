#pragma once

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// dump1090 / readsb host serving the SBS-1 BaseStation feed on :30003.
// Unauthenticated plaintext CSV -- check it with: nc <host> 30003
#define RECEIVER_HOST "192.0.2.10"
#define RECEIVER_PORT 30003

// Antenna position, used to compute range/bearing to each aircraft.
// Find it by dropping a pin on a map at the receiver's actual location.
#define RECEIVER_LAT 55.8642
#define RECEIVER_LON -4.2518
